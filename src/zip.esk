// zip.esk: reading and writing ZIP archives (PKWARE APPNOTE), with the
// stored and deflate methods and ZIP64 for large archives.
//
//     ZipReader r = ZipReader_open("pack.zip")?;
//     defer r.close();
//     for (i in 0..r.count()) printf("%s %llu\n", r.entry(i).name.data, r.entry(i).size);
//     Bytes b = r.read_name("docs/readme.txt")?;
//     defer b.free();
//
//     ZipWriter w = ZipWriter_new();
//     defer w.free();
//     w.add_dir("docs");
//     w.add("docs/readme.txt", (*uint8)text, strlen(text), 6)?;
//     w.finish_file("out.zip")?;
//
// The reader takes the entry list from the central directory and checks each
// entry's local header, size and CRC-32 when it is read. An entry is never
// inflated past the size the directory states, and an entry stating more than
// the reader's limit (INFLATE_DEFAULT_LIMIT unless changed) is refused, so a
// small archive cannot expand into all of memory. Encrypted entries, archives
// split over several disks and methods other than stored and deflate are
// reported as errors. ZipReader_extract_all refuses archives with an absolute
// entry name or a ".." component, and writes symbolic links as regular files
// holding the link target.
//
// Times are DOS times (2-second steps, 1980 to 2107) read and written as UTC;
// when an entry carries the extended timestamp field, its Unix time is used.

import <mem>;
import <bytes>;
import <string>;
import <list>;
import <fs>;
import <time>;
import <result>;
import <compress/checksum>;
import <compress/inflate>;
import <compress/deflate>;

const int ZIP_STORED = 0;
const int ZIP_DEFLATED = 8;

struct ZipEntry {
    String name;
    int method;
    int flags;
    uint32 crc;
    uint64 compressed_size;
    uint64 size;
    int64 mtime;
    uint32 external_attrs;
    uint64 offset;
    bool is_dir;
}

struct ZipReader {
    *uint8 data;
    uint64 len;
    bool owned;
    uint64 shift;
    uint64 limit;
    List<ZipEntry> entries;
}

struct _ZipCentral {
    String name;
    int method;
    int flags;
    uint32 crc;
    uint64 csize;
    uint64 usize;
    uint64 offset;
    int dtime;
    int ddate;
    uint32 attrs;
}

// A writer collects the archive in memory. mtime (Unix seconds, the time of
// ZipWriter_new by default) is stamped on the entries added after it is set;
// zip64 set to true writes ZIP64 records even when nothing needs them.
struct ZipWriter {
    Bytes out;
    List<_ZipCentral> entries;
    int64 mtime;
    bool zip64;
    bool finished;
}

// ---- little-endian fields ----

uint64 _zip_u16(*uint8 p) {
    return (uint64)p[0] | ((uint64)p[1] << 8);
}

uint64 _zip_u32(*uint8 p) {
    return (uint64)p[0] | ((uint64)p[1] << 8) | ((uint64)p[2] << 16) | ((uint64)p[3] << 24);
}

uint64 _zip_u64(*uint8 p) {
    return _zip_u32(p) | (_zip_u32(p + 4) << 32);
}

void _zip_put16(Bytes* b, uint64 v) {
    b.push((uint8)v);
    b.push((uint8)(v >> 8));
}

void _zip_put32(Bytes* b, uint64 v) {
    _zip_put16(b, v & 0xFFFF);
    _zip_put16(b, v >> 16);
}

void _zip_put64(Bytes* b, uint64 v) {
    _zip_put32(b, v & (uint64)0xFFFFFFFF);
    _zip_put32(b, v >> 32);
}

// ---- DOS times ----

int64 _zip_days(int64 y, int64 m, int64 d) {
    int64 yy = m <= 2 ? y - 1 : y;
    int64 era = (yy >= 0 ? yy : yy - 399) / 400;
    int64 yoe = yy - era * 400;
    int64 mp = (m + 9) % 12;
    int64 doy = (153 * mp + 2) / 5 + d - 1;
    int64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

int64 _zip_dos_to_unix(int64 dtime, int64 ddate) {
    int64 y = 1980 + (ddate >> 9);
    int64 mo = (ddate >> 5) & 15;
    int64 d = ddate & 31;
    if (mo < 1) mo = 1;
    if (mo > 12) mo = 12;
    if (d < 1) d = 1;
    int64 secs = (dtime >> 11) * 3600 + ((dtime >> 5) & 63) * 60 + (dtime & 31) * 2;
    return _zip_days(y, mo, d) * 86400 + secs;
}

// Splits Unix seconds into DOS time and date, clamped to 1980..2107.
void _zip_unix_to_dos(int64 t, *int dtime, *int ddate) {
    int64 lo = _zip_days(1980, 1, 1) * 86400;
    int64 hi = _zip_days(2107, 12, 31) * 86400 + 86399;
    int64 s = t < lo ? lo : (t > hi ? hi : t);
    int64 z = s / 86400 + 719468;
    int64 rem = s % 86400;
    int64 era = (z >= 0 ? z : z - 146096) / 146097;
    int64 doe = z - era * 146097;
    int64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    int64 y = yoe + era * 400;
    int64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    int64 mp = (5 * doy + 2) / 153;
    int64 d = doy - (153 * mp + 2) / 5 + 1;
    int64 m = mp < 10 ? mp + 3 : mp - 9;
    if (m <= 2) y++;
    *ddate = (int)(((y - 1980) << 9) | (m << 5) | d);
    *dtime = (int)(((rem / 3600) << 11) | (((rem / 60) % 60) << 5) | ((rem % 60) / 2));
}

// ---- reader ----

void ZipReader_close(ZipReader* self) {
    for (i in 0..self.entries.size) String_free(&self.entries.data[i].name);
    if (self.entries.data != null) List_free<ZipEntry>(&self.entries);
    if (self.owned && self.data != null) free((*void)self.data);
    self.data = null;
    self.len = 0;
    self.owned = false;
}

int ZipReader_count(ZipReader* self) {
    return self.entries.size;
}

ZipEntry* ZipReader_entry(ZipReader* self, int i) {
    return &self.entries.data[i];
}

// The index of the entry with this name, or -1.
int ZipReader_find(ZipReader* self, string name) {
    for (i in 0..self.entries.size) {
        if (strcmp(self.entries.data[i].name.data, name) == 0) return i;
    }
    return -1;
}

// Reads the ZIP64 fields of a central extra block: each is present only when
// its 32-bit field holds 0xFFFFFFFF.
string _zip_extra(*uint8 p, uint64 n, ZipEntry* e, bool usize64, bool csize64, bool off64) {
    uint64 i = 0;
    while (n - i >= 4) {
        uint64 id = _zip_u16(p + i);
        uint64 sz = _zip_u16(p + i + 2);
        i += 4;
        if (n - i < sz) return "zip: bad extra field";
        *uint8 f = p + i;
        if (id == 1) {
            uint64 k = 0;
            if (usize64) {
                if (sz - k < 8) return "zip: bad ZIP64 field";
                e.size = _zip_u64(f + k);
                k += 8;
            }
            if (csize64) {
                if (sz - k < 8) return "zip: bad ZIP64 field";
                e.compressed_size = _zip_u64(f + k);
                k += 8;
            }
            if (off64) {
                if (sz - k < 8) return "zip: bad ZIP64 field";
                e.offset = _zip_u64(f + k);
                k += 8;
            }
        } else if (id == 0x5455 && sz >= 5 && (f[0] & 1) != 0) {
            e.mtime = (int64)(int32)(uint32)_zip_u32(f + 1);
        }
        i += sz;
    }
    return null;
}

string _zip_parse(ZipReader* self) {
    *uint8 d = self.data;
    uint64 len = self.len;
    if (len < 22) return "zip: not a zip file";
    uint64 eocd = 0;
    bool found = false;
    uint64 i = len - 22;
    uint64 stop = len > 22 + 65535 ? len - 22 - 65535 : 0;
    while (true) {
        if (_zip_u32(d + i) == 0x06054b50 && i + 22 + _zip_u16(d + i + 20) <= len) {
            eocd = i;
            found = true;
            break;
        }
        if (i == stop) break;
        i--;
    }
    if (!found) return "zip: not a zip file";
    *uint8 e = d + eocd;
    uint64 disk = _zip_u16(e + 4);
    uint64 cd_disk = _zip_u16(e + 6);
    uint64 count = _zip_u16(e + 10);
    uint64 cd_size = _zip_u32(e + 12);
    uint64 cd_off = _zip_u32(e + 16);
    uint64 cd_end = eocd;
    if (eocd >= 20 && _zip_u32(d + eocd - 20) == 0x07064b50) {
        uint64 z = _zip_u64(d + eocd - 20 + 8);
        uint64 z_at = eocd - 20;
        if (z_at < 56) return "zip: bad ZIP64 end record";
        // The record may sit after a prefix (a self-extracting stub); it is
        // normally right before the locator.
        if (z > z_at - 56 || _zip_u32(d + z) != 0x06064b50) z = z_at - 56;
        if (_zip_u32(d + z) != 0x06064b50) return "zip: bad ZIP64 end record";
        disk = _zip_u32(d + z + 16);
        cd_disk = _zip_u32(d + z + 20);
        count = _zip_u64(d + z + 32);
        cd_size = _zip_u64(d + z + 40);
        cd_off = _zip_u64(d + z + 48);
        cd_end = z;
    }
    if (disk != 0 || cd_disk != 0) return "zip: multi-disk archives are not supported";
    if (cd_size > cd_end || cd_off > cd_end - cd_size) return "zip: bad central directory";
    // Bytes before the archive (a stub) shift every offset it records.
    self.shift = cd_end - cd_size - cd_off;
    if (count > cd_size / 46) return "zip: bad entry count";
    List_init<ZipEntry>(&self.entries, (int)count + 1);
    *uint8 p = d + cd_off + self.shift;
    uint64 left = cd_size;
    for (uint64 k = 0; k < count; k++) {
        if (left < 46 || _zip_u32(p) != 0x02014b50) return "zip: bad central directory";
        uint64 nlen = _zip_u16(p + 28);
        uint64 xlen = _zip_u16(p + 30);
        uint64 clen = _zip_u16(p + 32);
        uint64 total = 46 + nlen + xlen + clen;
        if (left < total) return "zip: bad central directory";
        let ent: ZipEntry;
        ent.flags = (int)_zip_u16(p + 8);
        ent.method = (int)_zip_u16(p + 10);
        ent.mtime = _zip_dos_to_unix((int64)_zip_u16(p + 12), (int64)_zip_u16(p + 14));
        ent.crc = (uint32)_zip_u32(p + 16);
        ent.compressed_size = _zip_u32(p + 20);
        ent.size = _zip_u32(p + 24);
        ent.external_attrs = (uint32)_zip_u32(p + 38);
        ent.offset = _zip_u32(p + 42);
        string err = _zip_extra(p + 46 + nlen, xlen, &ent, ent.size == 0xFFFFFFFF, ent.compressed_size == 0xFFFFFFFF, ent.offset == 0xFFFFFFFF);
        if (err != null) return err;
        ent.name.init((int64)nlen + 1);
        for (j in 0..(int)nlen) {
            if (p[46 + j] == 0) {
                ent.name.free();
                return "zip: bad entry name";
            }
            ent.name.push((char)p[46 + j]);
        }
        ent.is_dir = nlen > 0 && (p[46 + nlen - 1] == 47 || p[46 + nlen - 1] == 92);
        List_push<ZipEntry>(&self.entries, ent);
        p += total;
        left -= total;
    }
    return null;
}

// Opens an archive held in memory. The reader borrows data, which must
// outlive it.
Result<ZipReader, string> ZipReader_from(*uint8 data, uint64 len) {
    let r: ZipReader;
    r.data = data;
    r.len = len;
    r.limit = INFLATE_DEFAULT_LIMIT;
    string e = _zip_parse(&r);
    if (e != null) {
        r.close();
        return Err<ZipReader, string>(e);
    }
    return Ok<ZipReader, string>(r);
}

// Reads a whole archive file into memory and opens it.
Result<ZipReader, string> ZipReader_open(string path) {
    int64 n = 0;
    *uint8 data = fs_read_all(path, &n);
    if (data == null) return Err<ZipReader, string>("zip: cannot read the file");
    Result<ZipReader, string> r = ZipReader_from(data, (uint64)n);
    if (!r.ok) {
        free((*void)data);
        return r;
    }
    r.value.owned = true;
    return r;
}

// Reads entry i into a new Bytes, checking its size and CRC-32.
Result<Bytes, string> ZipReader_read(ZipReader* self, int i) {
    if (i < 0 || i >= self.entries.size) return Err<Bytes, string>("zip: no such entry");
    ZipEntry* e = &self.entries.data[i];
    if ((e.flags & 1) != 0) return Err<Bytes, string>("zip: encrypted entries are not supported");
    if (e.method != ZIP_STORED && e.method != ZIP_DEFLATED) return Err<Bytes, string>("zip: unsupported compression method");
    if (e.size > self.limit) return Err<Bytes, string>("zip: entry exceeds the size limit");
    uint64 lh = e.offset + self.shift;
    if (lh > self.len || self.len - lh < 30 || _zip_u32(self.data + lh) != 0x04034b50) return Err<Bytes, string>("zip: bad local header");
    uint64 at = lh + 30 + _zip_u16(self.data + lh + 26) + _zip_u16(self.data + lh + 28);
    if (at > self.len || self.len - at < e.compressed_size) return Err<Bytes, string>("zip: truncated entry");
    *uint8 src = self.data + at;
    let out: Bytes;
    out.init((int64)e.size + 1);
    if (out.data == null) return Err<Bytes, string>("zip: out of memory");
    if (e.method == ZIP_STORED) {
        if (e.compressed_size != e.size) {
            out.free();
            return Err<Bytes, string>("zip: size mismatch");
        }
        out.append_raw(src, (int64)e.size);
    } else {
        Result<uint64, string> r = inflate_raw_append(src, e.compressed_size, &out, e.size);
        if (!r.ok) {
            out.free();
            if (strcmp(r.error, "inflate: output exceeds the size limit") == 0) return Err<Bytes, string>("zip: entry larger than its stated size");
            return Err<Bytes, string>(r.error);
        }
        if ((uint64)out.len != e.size) {
            out.free();
            return Err<Bytes, string>("zip: size mismatch");
        }
    }
    if (crc32(out.data, (uint64)out.len) != e.crc) {
        out.free();
        return Err<Bytes, string>("zip: checksum mismatch");
    }
    return Ok<Bytes, string>(out);
}

// Reads the entry with this name.
Result<Bytes, string> ZipReader_read_name(ZipReader* self, string name) {
    int i = self.find(name);
    if (i < 0) return Err<Bytes, string>("zip: no such entry");
    return self.read(i);
}

// True when a name is safe to create under a directory: not empty, not
// absolute (no leading slash or backslash, no drive letter) and without a
// ".." component (either separator counts).
bool zip_name_is_safe(string name) {
    int n = (int)strlen(name);
    if (n == 0) return false;
    if (name[0] == '/' || name[0] == '\\') return false;
    if (n >= 2 && name[1] == ':') return false;
    int start = 0;
    for (i in 0..n + 1) {
        if (i == n || name[i] == '/' || name[i] == '\\') {
            if (i - start == 2 && name[start] == '.' && name[start + 1] == '.') return false;
            start = i + 1;
        }
    }
    return true;
}

// Writes every entry under dir (created if needed). Every name is checked
// before anything is written. Returns the number of entries written.
Result<int, string> ZipReader_extract_all(ZipReader* self, string dir) {
    for (i in 0..self.entries.size) {
        if (!zip_name_is_safe(self.entries.data[i].name.data)) return Err<int, string>("zip: unsafe entry name");
    }
    if (fs_mkdir_p(dir) != 0) return Err<int, string>("zip: cannot create the directory");
    let path: String;
    path.init(256);
    defer path.free();
    for (i in 0..self.entries.size) {
        ZipEntry* e = &self.entries.data[i];
        path.clear();
        path.append(dir);
        path.push('/');
        path.append(e.name.data);
        for (k in 0..(int)path.len) {
            if (path.data[k] == '\\') path.data[k] = '/';
        }
        if (e.is_dir) {
            if (fs_mkdir_p(path.data) != 0) return Err<int, string>("zip: cannot create a directory");
            continue;
        }
        int64 slash = path.len - 1;
        while (slash > 0 && path.data[slash] != '/') slash--;
        path.data[slash] = 0;
        int made = fs_mkdir_p(path.data);
        path.data[slash] = '/';
        if (made != 0) return Err<int, string>("zip: cannot create a directory");
        Result<Bytes, string> r = self.read(i);
        if (!r.ok) return Err<int, string>(r.error);
        Bytes b = r.value;
        int ok = fs_write_all(path.data, b.data, b.len);
        b.free();
        if (ok != 1) return Err<int, string>("zip: cannot write a file");
    }
    return Ok<int, string>(self.entries.size);
}

// ---- writer ----

ZipWriter ZipWriter_new() {
    let w: ZipWriter;
    w.out.init(1024);
    List_init<_ZipCentral>(&w.entries, 16);
    w.mtime = time_now_s();
    return w;
}

void ZipWriter_free(ZipWriter* self) {
    for (i in 0..self.entries.size) String_free(&self.entries.data[i].name);
    if (self.entries.data != null) List_free<_ZipCentral>(&self.entries);
    self.out.free();
}

bool _zip_utf8(string s) {
    int64 n = strlen(s);
    for (int64 i = 0; i < n; i++) {
        if ((int)(uint8)s[i] >= 128) return true;
    }
    return false;
}

// Appends a local header and the data, and records the entry.
Result<int, string> _zip_put(ZipWriter* self, string name, int method, uint32 crc, *uint8 data, uint64 csize, uint64 usize, uint32 attrs) {
    if (self.finished) return Err<int, string>("zip: the writer is finished");
    int64 nlen = strlen(name);
    if (nlen == 0 || nlen > 65535) return Err<int, string>("zip: bad entry name");
    Bytes* o = &self.out;
    let c: _ZipCentral;
    c.method = method;
    c.flags = _zip_utf8(name) ? 0x800 : 0;
    c.crc = crc;
    c.csize = csize;
    c.usize = usize;
    c.offset = (uint64)o.len;
    c.attrs = attrs;
    _zip_unix_to_dos(self.mtime, &c.dtime, &c.ddate);
    bool big = self.zip64 || usize >= 0xFFFFFFFF || csize >= 0xFFFFFFFF;
    o.reserve((int64)csize + nlen + 64);
    _zip_put32(o, 0x04034b50);
    _zip_put16(o, big ? 45 : (method == ZIP_DEFLATED ? 20 : 10));
    _zip_put16(o, (uint64)c.flags);
    _zip_put16(o, (uint64)method);
    _zip_put16(o, (uint64)c.dtime);
    _zip_put16(o, (uint64)c.ddate);
    _zip_put32(o, (uint64)crc);
    _zip_put32(o, big ? 0xFFFFFFFF : csize);
    _zip_put32(o, big ? 0xFFFFFFFF : usize);
    _zip_put16(o, (uint64)nlen);
    _zip_put16(o, big ? 20 : 0);
    o.append_raw((*uint8)name, nlen);
    if (big) {
        _zip_put16(o, 1);
        _zip_put16(o, 16);
        _zip_put64(o, usize);
        _zip_put64(o, csize);
    }
    if (csize > 0) o.append_raw(data, (int64)csize);
    c.name.from(name);
    List_push<_ZipCentral>(&self.entries, c);
    return Ok<int, string>(0);
}

// Adds a file entry holding data[0..len), deflated at level (1 to 9) or stored
// (level 0, or when deflating does not make it smaller).
Result<int, string> ZipWriter_add(ZipWriter* self, string name, *uint8 data, uint64 len, int level) {
    uint32 crc = crc32(data, len);
    uint32 attrs = (uint32)0x81A40000;
    if (level > 0 && len > 0) {
        Result<Bytes, string> r = deflate_raw(data, len, level);
        if (!r.ok) return Err<int, string>(r.error);
        Bytes c = r.value;
        defer c.free();
        if ((uint64)c.len < len) return _zip_put(self, name, ZIP_DEFLATED, crc, c.data, (uint64)c.len, len, attrs);
    }
    return _zip_put(self, name, ZIP_STORED, crc, data, len, len, attrs);
}

// Adds a directory entry; a missing trailing slash is added.
Result<int, string> ZipWriter_add_dir(ZipWriter* self, string name) {
    let n: String;
    n.from(name);
    defer n.free();
    if (n.len == 0 || n.data[n.len - 1] != '/') n.push('/');
    return _zip_put(self, n.data, ZIP_STORED, 0, null, 0, 0, (uint32)0x41ED0010);
}

// Adds the file at path under the entry name.
Result<int, string> ZipWriter_add_file(ZipWriter* self, string name, string path, int level) {
    int64 n = 0;
    *uint8 data = fs_read_all(path, &n);
    if (data == null) return Err<int, string>("zip: cannot read the file");
    defer free((*void)data);
    return self.add(name, data, (uint64)n, level);
}

// Writes the central directory and returns the archive. The writer keeps no
// buffer afterwards; it still has to be freed.
Result<Bytes, string> ZipWriter_finish(ZipWriter* self) {
    if (self.finished) return Err<Bytes, string>("zip: the writer is finished");
    Bytes* o = &self.out;
    uint64 cd_start = (uint64)o.len;
    uint64 count = (uint64)self.entries.size;
    for (i in 0..self.entries.size) {
        _ZipCentral* c = &self.entries.data[i];
        bool u64 = self.zip64 || c.usize >= 0xFFFFFFFF;
        bool c64 = self.zip64 || c.csize >= 0xFFFFFFFF;
        bool o64 = self.zip64 || c.offset >= 0xFFFFFFFF;
        uint64 xlen = 0;
        if (u64) xlen += 8;
        if (c64) xlen += 8;
        if (o64) xlen += 8;
        if (xlen > 0) xlen += 4;
        bool any64 = xlen > 0 || c.usize >= 0xFFFFFFFF || c.csize >= 0xFFFFFFFF;
        _zip_put32(o, 0x02014b50);
        _zip_put16(o, (3 << 8) | 45);
        _zip_put16(o, any64 ? 45 : (c.method == ZIP_DEFLATED ? 20 : 10));
        _zip_put16(o, (uint64)c.flags);
        _zip_put16(o, (uint64)c.method);
        _zip_put16(o, (uint64)c.dtime);
        _zip_put16(o, (uint64)c.ddate);
        _zip_put32(o, (uint64)c.crc);
        _zip_put32(o, c64 ? 0xFFFFFFFF : c.csize);
        _zip_put32(o, u64 ? 0xFFFFFFFF : c.usize);
        _zip_put16(o, (uint64)c.name.len);
        _zip_put16(o, xlen);
        _zip_put16(o, 0);
        _zip_put16(o, 0);
        _zip_put16(o, 0);
        _zip_put32(o, (uint64)c.attrs);
        _zip_put32(o, o64 ? 0xFFFFFFFF : c.offset);
        o.append_raw((*uint8)c.name.data, c.name.len);
        if (xlen > 0) {
            _zip_put16(o, 1);
            _zip_put16(o, xlen - 4);
            if (u64) _zip_put64(o, c.usize);
            if (c64) _zip_put64(o, c.csize);
            if (o64) _zip_put64(o, c.offset);
        }
    }
    uint64 cd_size = (uint64)o.len - cd_start;
    bool z64 = self.zip64 || count >= 0xFFFF || cd_start >= 0xFFFFFFFF || cd_size >= 0xFFFFFFFF;
    if (z64) {
        uint64 rec = (uint64)o.len;
        _zip_put32(o, 0x06064b50);
        _zip_put64(o, 44);
        _zip_put16(o, (3 << 8) | 45);
        _zip_put16(o, 45);
        _zip_put32(o, 0);
        _zip_put32(o, 0);
        _zip_put64(o, count);
        _zip_put64(o, count);
        _zip_put64(o, cd_size);
        _zip_put64(o, cd_start);
        _zip_put32(o, 0x07064b50);
        _zip_put32(o, 0);
        _zip_put64(o, rec);
        _zip_put32(o, 1);
    }
    _zip_put32(o, 0x06054b50);
    _zip_put16(o, 0);
    _zip_put16(o, 0);
    _zip_put16(o, z64 ? 0xFFFF : count);
    _zip_put16(o, z64 ? 0xFFFF : count);
    _zip_put32(o, z64 ? 0xFFFFFFFF : cd_size);
    _zip_put32(o, z64 ? 0xFFFFFFFF : cd_start);
    _zip_put16(o, 0);
    self.finished = true;
    Bytes b = self.out;
    self.out.data = null;
    self.out.len = 0;
    self.out.cap = 0;
    return Ok<Bytes, string>(b);
}

// Finishes the archive and writes it to path.
Result<int, string> ZipWriter_finish_file(ZipWriter* self, string path) {
    Result<Bytes, string> r = self.finish();
    if (!r.ok) return Err<int, string>(r.error);
    Bytes b = r.value;
    int ok = fs_write_all(path, b.data, b.len);
    b.free();
    if (ok != 1) return Err<int, string>("zip: cannot write the file");
    return Ok<int, string>(0);
}
